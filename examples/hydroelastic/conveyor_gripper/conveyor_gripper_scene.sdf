<?xml version="1.0"?>
<sdf xmlns:drake="http://drake.mit.edu" version="1.7">
  <model name="floor_and_boxes">
    <link name="floor">
      <pose>0 0 0 0 0 -0.005  </pose>
      <visual name="floor_visual">
        <geometry>
          <box>
            <size>10 10 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1.0</ambient> <!-- Gray color -->
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
        </material>
      </visual>
      <collision name="floor_collision">
        <geometry>
          <box>
            <size>10 10 0.01</size>
          </box>
        </geometry>
        <!-- <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>5e6</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.01</drake:mesh_resolution_hint>
          <drake:mu_dynamic>0.5</drake:mu_dynamic>
          <drake:mu_static>0.6</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
        </drake:proximity_properties> -->
      </collision>
    </link>
    <joint name="fixed_floor" type="fixed">
      <parent>world</parent>
      <child>floor</child>
    </joint>

    <link name="large_support">
      <pose>0.0 1.0 0.255 0 0 0</pose>
      <visual name="large_support_visual">
        <geometry>
          <box>
            <size>2.0 1.0 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.3 0.4 1.0</ambient> <!-- Red -->
          <diffuse>0.2 0.3 0.4 1.0</diffuse>
        </material>
      </visual>
      <collision name="large_support_collision">
        <geometry>
          <box>
            <size>2.0 1.0 0.5</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e6</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.01</drake:mesh_resolution_hint>
          <drake:mu_dynamic>0.25</drake:mu_dynamic>
          <drake:mu_static>0.41</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>
    </link>

    <!-- Boxes -->
    <link name="box_1">
      <pose>0.3 0.7 0.9 0 0 0</pose>
      <visual name="box_1_visual">
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 0.6</ambient> <!-- Red -->
          <diffuse>1.0 0.0 0.0 0.6</diffuse>
        </material>
      </visual>
      <collision name="box_1_collision">
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e5</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.01</drake:mesh_resolution_hint>
          <drake:mu_dynamic>1.4</drake:mu_dynamic>
          <drake:mu_static>1.5</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>
    </link>

    <link name="gripper">
      <pose>0.0 0.0 0.0 0 0 0.3</pose>
      <visual name="gripper_visual">
        <geometry>
          <box>
            <size>0.4 0.05 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.43 0.3 0.7 0.6</ambient> <!-- Gray -->
          <diffuse>0.43 0.3 0.7 0.6</diffuse>
        </material>
      </visual>
      <collision name="gripper_collision">
        <geometry>
          <box>
            <size>0.4 0.05 0.3</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e6</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.01</drake:mesh_resolution_hint>
          <drake:mu_dynamic>1.4</drake:mu_dynamic>
          <drake:mu_static>1.5</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
          <drake:surface_speed>0.5</drake:surface_speed>
          <drake:surface_velocity_normal>0 0 1</drake:surface_velocity_normal>
        </drake:proximity_properties>
      </collision>
    </link>
  </model>
</sdf>